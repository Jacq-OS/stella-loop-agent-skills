{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellaloop.dev/schemas/agent-skills-pack-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packVersion",
    "minStella",
    "repository",
    "sourceCommit",
    "tag",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "minStella": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "repository": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
